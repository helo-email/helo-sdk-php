{
    "name": "helo-email/sdk",
    "description": "Helo Email API (https://helohq.com)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "HeloEmail\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HeloEmail\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
